        "url": {
          "raw": "{{baseUrl}}/publishers/{{createdNxbId}}",
          "host": ["{{baseUrl}}"],
          "path": ["publishers", "{{createdNxbId}}"]
        }
      }
    },
    {
      "name": "09. [PATCH] Doi trang thai sang NGUNG_HOAT_DONG (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 200 OK', function () {",
              "    pm.response.to.have.status(200);",
