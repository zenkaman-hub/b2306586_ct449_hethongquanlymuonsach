    {
      "name": "06. [POST] Tao moi Dau sach thanh cong & Kiem tra cong thuc ton kho (201 Created)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const uniqueSuffix = Date.now();",
              "pm.collectionVariables.set('tenSachTest', 'Cau Truc Du Lieu AutoTest ' + uniqueSuffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Tu sinh maSach va tinh dung soQuyenKhaDung = tongSoQuyen (15) - soQuyenHuHong (2) = 13', function () {",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data.maSach).to.match(/^S\\d+$/);",
              "    pm.expect(json.data.tongSoQuyen).to.eql(15);",
              "    pm.expect(json.data.soQuyenDangMuon).to.eql(0);",
              "    pm.expect(json.data.soQuyenHuHong).to.eql(2);",
              "    pm.expect(json.data.soQuyenKhaDung).to.eql(13);",
              "    pm.expect(json.data.trangThaiLuuThong).to.eql('DANG_LUU_THONG');",
              "});",
              "if (json.data && json.data._id) {",
              "    pm.collectionVariables.set('createdSachId', json.data._id);",
              "    pm.collectionVariables.set('createdMaSach', json.data.maSach);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenSach\": \"{{tenSachTest}}\",\n  \"donGia\": 125000,\n  \"tongSoQuyen\": 15,\n  \"soQuyenHuHong\": 2,\n  \"namXuatBan\": 2024,\n  \"nhaXuatBanId\": \"{{activeNxbId}}\",\n  \"nguonGocTacGia\": \"Tran Van Kiem Thu\",\n  \"trangThaiLuuThong\": \"DANG_LUU_THONG\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
