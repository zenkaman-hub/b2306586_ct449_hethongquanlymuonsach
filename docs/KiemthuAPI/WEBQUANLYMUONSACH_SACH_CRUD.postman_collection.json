    {
      "name": "05. [GET] Lay danh sach Sach & Loc conSachKhaDung (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Tra ve danhSach sach kem thong tin NXB populate va phanTrang', function () {",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data.danhSach).to.be.an('array');",
              "    pm.expect(json.data.phanTrang).to.be.an('object');",
              "    if (json.data.danhSach.length > 0) {",
              "        pm.expect(json.data.danhSach[0].soQuyenKhaDung).to.be.above(0);",
              "        pm.expect(json.data.danhSach[0].nhaXuatBanId).to.be.an('object');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?conSachKhaDung=true&trangThaiLuuThong=DANG_LUU_THONG&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "conSachKhaDung",
              "value": "true"
            },
            {
              "key": "trangThaiLuuThong",
              "value": "DANG_LUU_THONG"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
