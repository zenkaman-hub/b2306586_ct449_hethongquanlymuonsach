    {
      "name": "03. [GET] Lay NXB dang HOAT_DONG de gan cho Sach",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "const activeNxb = json.data.danhSach.find(n => n.trangThai === 'HOAT_DONG');",
              "pm.test('Tim thay it nhat 1 NXB dang HOAT_DONG', function () {",
              "    pm.expect(activeNxb).to.be.an('object');",
              "});",
              "if (activeNxb) {",
              "    pm.collectionVariables.set('activeNxbId', activeNxb._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/publishers?trangThai=HOAT_DONG",
          "host": ["{{baseUrl}}"],
          "path": ["publishers"],
          "query": [
            {
              "key": "trangThai",
              "value": "HOAT_DONG"
            }
          ]
        }
      }
    },
