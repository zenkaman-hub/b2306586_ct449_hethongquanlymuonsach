    {
      "name": "01. Dang nhap Thu thu (THU_THU)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Dang nhap Thu thu thanh cong', function () {",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data.taiKhoan.vaiTro).to.eql('THU_THU');",
              "});",
              "if (json.data && json.data.token) {",
              "    pm.collectionVariables.set('librarianToken', json.data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenDangNhap\": \"thuthu\",\n  \"matKhau\": \"ThuThu@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
