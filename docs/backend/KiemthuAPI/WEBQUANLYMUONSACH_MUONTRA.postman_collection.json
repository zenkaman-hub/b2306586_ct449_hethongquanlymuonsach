              "pm.test('Status code la 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "const activeNxb = json.data.danhSach.find(n => n.trangThai === 'HOAT_DONG');",
              "if (activeNxb) {",
              "    pm.collectionVariables.set('activeNxbId', activeNxb._id);",
              "}"
