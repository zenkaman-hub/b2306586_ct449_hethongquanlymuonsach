    {
      "name": "01. Dang nhap Admin (QUAN_TRI) & Luu adminNhanVienId",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Dang nhap Admin thanh cong', function () {",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data.taiKhoan.vaiTro).to.eql('QUAN_TRI');",
              "    pm.expect(json.data.hoSo._id).to.be.a('string');",
              "});",
              "if (json.data && json.data.token) {",
              "    pm.collectionVariables.set('adminToken', json.data.token);",
              "    pm.collectionVariables.set('adminNhanVienId', json.data.hoSo._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenDangNhap\": \"admin\",\n  \"matKhau\": \"Admin@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
