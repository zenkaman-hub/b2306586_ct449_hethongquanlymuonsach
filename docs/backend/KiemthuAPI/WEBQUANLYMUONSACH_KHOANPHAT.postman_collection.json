      "name": "09. [POST /loans] Lap Phieu muon 3 cuon sach cho testDocGia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "if (json.data && json.data._id) {",
              "    pm.collectionVariables.set('phieuMuonId', json.data._id);",
              "    const ct1 = json.data.chiTietMuon.find(c => c.sachId === pm.collectionVariables.get('sach1Id'));",
              "    const ct2 = json.data.chiTietMuon.find(c => c.sachId === pm.collectionVariables.get('sach2Id'));",
              "    const ct3 = json.data.chiTietMuon.find(c => c.sachId === pm.collectionVariables.get('sach3Id'));",
              "    if (ct1) pm.collectionVariables.set('ct1Id', ct1._id);",
              "    if (ct2) pm.collectionVariables.set('ct2Id', ct2._id);",
              "    if (ct3) pm.collectionVariables.set('ct3Id', ct3._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{librarianToken}}"
