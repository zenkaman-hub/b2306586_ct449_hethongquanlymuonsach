          "mode": "raw",
          "raw": "{\n  \"docGiaId\": \"{{testDocGiaId}}\",\n  \"ghiChu\": \"Phieu muon test xu ly khoan phat\",\n  \"danhSachSach\": [\n    { \"sachId\": \"{{sach1Id}}\" },\n    { \"sachId\": \"{{sach2Id}}\" },\n    { \"sachId\": \"{{sach3Id}}\" }\n  ]\n}"
        },
