    {
      "name": "10. [POST /loans/:id/return] Tra 3 cuon phat sinh 3 Khoan Phat (30k, 100k, 150k => Tong 280k)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code la 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Phat sinh 3 khoan phat (tong 280000 VND) va han che quyen muon doc gia', function () {",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data.danhSachKhoanPhat.length).to.eql(3);",
              "    pm.expect(json.data.docGiaId.tongTienPhatChuaTra).to.eql(280000);",
              "    pm.expect(json.data.docGiaId.trangThaiQuyenMuon).to.eql('BI_HAN_CHE');",
              "});",
              "const kp1 = json.data.danhSachKhoanPhat.find(k => k.chiTietMuonId === pm.collectionVariables.get('ct1Id'));",
              "const kp2 = json.data.danhSachKhoanPhat.find(k => k.chiTietMuonId === pm.collectionVariables.get('ct2Id'));",
              "const kp3 = json.data.danhSachKhoanPhat.find(k => k.chiTietMuonId === pm.collectionVariables.get('ct3Id'));",
              "if (kp1) pm.collectionVariables.set('kp1Id', kp1._id);",
              "if (kp2) pm.collectionVariables.set('kp2Id', kp2._id);",
              "if (kp3) pm.collectionVariables.set('kp3Id', kp3._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{librarianToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ghiChu\": \"Tra 3 cuon phat sinh 3 khoan phat de test thu tien, mien phat va huy phat\",\n  \"danhSachTra\": [\n    {\n      \"chiTietMuonId\": \"{{ct1Id}}\",\n      \"tinhTrangKhiTra\": \"HU_HONG_NHE\",\n      \"moTaHuHong\": \"Ghi nham hu hong nhe (de test HUY_PHAT)\",\n      \"soTienBoiThuong\": 30000\n    },\n    {\n      \"chiTietMuonId\": \"{{ct2Id}}\",\n      \"tinhTrangKhiTra\": \"HU_HONG_NANG\",\n      \"moTaHuHong\": \"Rach bia va 15 trang (de test THANH_TOAN 1 phan & toan bo)\"\n    },\n    {\n      \"chiTietMuonId\": \"{{ct3Id}}\",\n      \"tinhTrangKhiTra\": \"MAT\",\n      \"moTaHuHong\": \"Mat sach (de test MIEN_PHAT)\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/loans/{{phieuMuonId}}/return",
          "host": ["{{baseUrl}}"],
          "path": ["loans", "{{phieuMuonId}}", "return"]
        }
      }
